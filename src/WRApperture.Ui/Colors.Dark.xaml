<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Keys must match Colors.Light.xaml; screens use them with DynamicResource. -->
    <SolidColorBrush x:Key="Background" Color="#1B1D22" />
    <SolidColorBrush x:Key="Surface" Color="#25282F" />
    <SolidColorBrush x:Key="Border" Color="#3B404A" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#2563EB" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileHover" Color="#2C3546" />
    <SolidColorBrush x:Key="TileSelected" Color="#1E3A6B" />
    <SolidColorBrush x:Key="Muted" Color="#A3AAB7" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningBackground" Color="#3A2E12" />
    <SolidColorBrush x:Key="Error" Color="#F87171" />
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="Overlay" Color="#B31B1D22" />
    <SolidColorBrush x:Key="Text" Color="#E6E8EC" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4B515C" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#25282F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E8EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#25282F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6E8EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#1B1D22" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7D8492" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A6B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6E8EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#25282F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E8EC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#25282F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E6E8EC" />
</ResourceDictionary>
