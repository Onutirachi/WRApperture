<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette. Keys must match Colors.Light.xaml; screens use them with DynamicResource.
        Layered like Windows 11: the window is Mica (or Background when Mica is unavailable), content sits on
        translucent layers and controls are faint white washes, so everything picks up the backdrop.
    -->
    <SolidColorBrush x:Key="Background" Color="#202020" />
    <SolidColorBrush x:Key="Sidebar" Color="Transparent" />
    <SolidColorBrush x:Key="Layer" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="Surface" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Popup" Color="#F22C2C2C" />
    <SolidColorBrush x:Key="Border" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#5B97F8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="TilePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TileSelected" Color="#403B82F6" />
    <SolidColorBrush x:Key="Muted" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="Faint" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="Warning" Color="#FCD34D" />
    <SolidColorBrush x:Key="WarningBackground" Color="#33F59E0B" />
    <SolidColorBrush x:Key="Error" Color="#F87171" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#2EEF4444" />
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#2E22C55E" />
    <SolidColorBrush x:Key="Overlay" Color="#99000000" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Watermark" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#5CFFFFFF" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8B8B8B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2B3E5E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2C2C2C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFFFFF" />
</ResourceDictionary>
