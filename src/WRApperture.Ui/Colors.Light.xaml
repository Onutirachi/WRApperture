<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Light palette. Keys must match Colors.Dark.xaml; screens use them with DynamicResource.
        Layered like Windows 11: the window is Mica (or Background when Mica is unavailable), content sits on
        translucent white layers and controls are near-white, so everything picks up the backdrop.
    -->
    <SolidColorBrush x:Key="Background" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Sidebar" Color="Transparent" />
    <SolidColorBrush x:Key="Layer" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Popup" Color="#FAF9F9F9" />
    <SolidColorBrush x:Key="Border" Color="#12000000" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileHover" Color="#F0F2F2F2" />
    <SolidColorBrush x:Key="TilePressed" Color="#E6EAEAEA" />
    <SolidColorBrush x:Key="TileSelected" Color="#292563EB" />
    <SolidColorBrush x:Key="Muted" Color="#5F5F5F" />
    <SolidColorBrush x:Key="Faint" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Warning" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="Error" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#1FC42B1C" />
    <SolidColorBrush x:Key="Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#1F0F7B0F" />
    <SolidColorBrush x:Key="Overlay" Color="#99F3F3F3" />
    <SolidColorBrush x:Key="Text" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#72000000" />

    <!-- Pinned system colors: default controls must not inherit a mismatching Windows theme. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8A8A8A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DBE5FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F9F9F9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#F9F9F9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#1B1B1B" />
</ResourceDictionary>
