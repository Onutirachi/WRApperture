<Window x:Class="WRApperture.Ui.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui"
        Title="{loc:T common.language.title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock Text="{loc:T common.language.title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
        <ComboBox x:Name="Choices" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T common.language.title}" />
        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{loc:T common.language.hint}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T common.buttons.cancel}" Style="{DynamicResource Secondary}" IsCancel="True" />
            <Button Content="{loc:T common.buttons.ok}" Style="{DynamicResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
