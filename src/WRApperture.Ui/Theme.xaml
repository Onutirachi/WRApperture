<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:WRApperture.Ui">
    <!--
        Shared WRApperture look (client and host manager), in the Windows 11 style: no outlines, rounded controls,
        translucent layers over the window's Mica backdrop (see ThemeManager). Colors come from Colors.Light.xaml or
        Colors.Dark.xaml, which ThemeManager swaps at runtime: always use DynamicResource for them.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WRApperture.Ui;component/Colors.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Windows' own icon font: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10 (same code points). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

