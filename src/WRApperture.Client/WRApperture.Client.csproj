<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); the UI itself is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WRApperture</AssemblyName>
    <RootNamespace>WRApperture.Client</RootNamespace>
    <ApplicationIcon>../../assets/icons/WRApperture.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF names (Application, MessageBox, Button…) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WRApperture.Client.Core\WRApperture.Client.Core.csproj" />
    <ProjectReference Include="..\WRApperture.Ui\WRApperture.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- Shortcut icons: the client's own icon and the corner badge (built by scripts/build-icons.ps1). -->
  <ItemGroup>
    <Resource Include="../../assets/icons/client.png" Link="Assets/client.png" />
    <Resource Include="../../assets/icons/badge.png" Link="Assets/badge.png" />
  </ItemGroup>

</Project>
