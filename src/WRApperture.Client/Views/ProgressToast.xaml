        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WRApperture.Client.Views"
        Title="WRApperture" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
