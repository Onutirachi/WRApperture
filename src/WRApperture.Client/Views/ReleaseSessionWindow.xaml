<Window x:Class="WRApperture.Client.Views.ReleaseSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Title="{loc:T client.release.title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="SessionsText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border x:Name="LogoffWarning" Background="{DynamicResource WarningBackground}" CornerRadius="8" Padding="10">
            <TextBlock x:Name="LogoffWarningText" TextWrapping="Wrap" Foreground="{DynamicResource Warning}"
                       Text="{loc:T client.release.appWarning}" />
        </Border>

        <CheckBox x:Name="AlwaysBox" Margin="0,14,0,0" Content="{loc:T client.release.dontAskAgain}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T client.buttons.cancel}" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="{loc:T client.release.confirm}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
