<Window x:Class="WRApperture.Client.Views.ReleaseSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC remoto em uso" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="SessionsText" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border x:Name="LogoffWarning" Background="{DynamicResource WarningBackground}" CornerRadius="4" Padding="10">
            <TextBlock x:Name="LogoffWarningText" TextWrapping="Wrap" Foreground="{DynamicResource Warning}"
                       Text="Para abrir o app, essa sessão será encerrada (logoff). Os programas abertos no PC remoto serão fechados e o que não foi salvo será perdido." />
        </Border>

        <CheckBox x:Name="AlwaysBox" Margin="0,14,0,0" Content="Não perguntar novamente para este PC" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="Encerrar e abrir" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
