<Window x:Class="WRApperture.Client.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Title="{loc:T client.credentials.title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="IntroText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                   Text="{loc:T client.credentials.firstIntro}" />

        <TextBlock Text="{loc:T client.credentials.userLabel}" Margin="0,4,0,4" />
        <TextBox x:Name="UserBox" AutomationProperties.Name="{loc:T client.credentials.user}" />
        <TextBlock x:Name="UserHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{loc:T client.credentials.userHint}" />

        <TextBlock Text="{loc:T client.credentials.password}" Margin="0,10,0,4" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{loc:T client.credentials.password}" />

        <Border x:Name="MicrosoftHint" Background="{DynamicResource WarningBackground}" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Text="{loc:T client.credentials.microsoftHint}" />
        </Border>

        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{loc:T client.credentials.storageHint}" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{loc:T client.buttons.cancel}" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="{loc:T client.buttons.save}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
