<Window x:Class="WRApperture.Client.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenciais do host" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock Text="Usuário do Windows no PC remoto" Margin="0,0,0,4" />
        <TextBox x:Name="UserBox" AutomationProperties.Name="Usuário" />
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Ex.: PC-ESCRITORIO\joao, ou o e-mail da conta Microsoft." />

        <TextBlock Text="Senha" Margin="0,10,0,4" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Senha" />

        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="A senha fica no Gerenciador de Credenciais do Windows deste computador, não no WRApperture." />

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="Salvar" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
