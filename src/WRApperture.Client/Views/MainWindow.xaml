<Window x:Class="WRApperture.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Client.ViewModels"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WRApperture" Width="1000" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- Grid / list switch: two radio buttons drawn as a segmented control -->
        <Style x:Key="ViewToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="4" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ○○○ menu of a host card: acts on the selected host (the button selects its card first). -->
        <ContextMenu x:Key="HostMenu">
            <MenuItem Header="{loc:T client.host.rename}" Command="{Binding RenameHostCommand}" />
            <MenuItem Tag="color" Header="{loc:T client.host.color}" />
            <Separator />
            <MenuItem Header="{loc:T client.main.saveCredentials}" Command="{Binding SaveCredentialsCommand}" />
            <MenuItem Header="{loc:T client.main.deleteCredentials}" Command="{Binding DeleteCredentialsCommand}" />
            <MenuItem Header="{loc:T client.main.askBeforeRelease}" IsCheckable="True"
                      IsChecked="{Binding AskBeforeReleasingSession, Mode=TwoWay}"
                      ToolTip="{loc:T client.main.askBeforeReleaseTip}" />
            <Separator />
            <MenuItem Header="{loc:T client.main.syncNow}" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            <MenuItem Header="{loc:T client.main.updateHost}" Command="{Binding UpdateHostCommand}"
                      Visibility="{Binding IsHostOutdated, Converter={StaticResource BoolToVis}}"
                      ToolTip="{loc:T client.main.updateHostTip}" ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="{loc:T client.main.removeHost}" Command="{Binding RemoveHostCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Hosts -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T client.main.hosts}" FontSize="15" FontWeight="SemiBold" Margin="16,14,16,10" />

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,8">
                    <UniformGrid Columns="2">
                        <Button Content="⚙" Style="{StaticResource Secondary}" Margin="0,0,4,0" Padding="10,4" FontSize="15"
                                Command="{Binding ToggleSettingsCommand}" ToolTip="{loc:T client.main.settings}"
                                AutomationProperties.Name="{loc:T client.main.settings}" />
                        <Button Content="+" Style="{StaticResource Secondary}" Margin="4,0,0,0" Padding="10,4" FontSize="15"
                                Command="{Binding AddHostCommand}" ToolTip="{loc:T client.main.addHost}"
                                AutomationProperties.Name="{loc:T client.main.addHost}" />
                    </UniformGrid>
                </Border>

                <ListBox x:Name="HostsList" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:T client.main.hosts}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileSelected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HostOption}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" Background="{Binding ColorBrush}" />
                                <Grid Margin="12,8,6,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="⋯" Padding="6,0" Style="{StaticResource Secondary}" BorderThickness="0" Background="Transparent"
                                            Click="OnHostMenuClick" ToolTip="{loc:T client.main.moreOptions}" AutomationProperties.Name="{loc:T client.main.moreOptions}" />
                                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AppsText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border DockPanel.Dock="Left" Margin="10,0,0,0" Padding="7,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Warning}"
                                                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:T client.host.offline}" FontSize="10" Foreground="{DynamicResource Warning}" />
                                        </Border>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The selected host (or the settings page) -->
        <DockPanel Grid.Column="1">
            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ClientVersionText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <!-- A newer client that was not installed automatically (automatic updates off) -->
                    <Button DockPanel.Dock="Right" Content="{Binding ClientUpdateLabel}" Style="{StaticResource Secondary}" Padding="10,2" Margin="12,0,0,0"
                            Command="{Binding InstallClientUpdateCommand}" Visibility="{Binding IsClientUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Empty state: no hosts -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasNoHost, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T client.main.noHostTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" Foreground="{DynamicResource Muted}"
                               Text="{loc:T client.main.noHostText}" />
                    <Button Content="{loc:T client.main.addHost}" Style="{StaticResource Primary}" HorizontalAlignment="Center" Command="{Binding AddHostCommand}" />
                </StackPanel>

                <!-- Host: header, search, desktop, view switch, apps -->
                <DockPanel Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="24,18,24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedHost.Label}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" Padding="12,3" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{DynamicResource Success}" ToolTip="{loc:T client.main.hostVpnTip}"
                                Visibility="{Binding HasHostVpn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HostVpnText}" FontSize="12" Foreground="{DynamicResource Success}" />
                        </Border>
                    </Grid>

                    <DockPanel DockPanel.Dock="Top" Margin="24,4,24,8" LastChildFill="False">
                        <Grid DockPanel.Dock="Left" Width="260">
                            <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T client.main.searchApps}" />
                            <TextBlock Text="{loc:T client.main.searchPlaceholder}" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Grid / list -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <RadioButton Content="▦" GroupName="View" IsChecked="{Binding IsGridView}" Style="{StaticResource ViewToggle}"
                                         ToolTip="{loc:T client.main.gridView}" AutomationProperties.Name="{loc:T client.main.gridView}" />
                            <RadioButton Content="☰" GroupName="View" IsChecked="{Binding IsListView}" Style="{StaticResource ViewToggle}" Margin="4,0,0,0"
                                         ToolTip="{loc:T client.main.listView}" AutomationProperties.Name="{loc:T client.main.listView}" />
                        </StackPanel>

                        <Button x:Name="DesktopButton" DockPanel.Dock="Right" Content="{loc:T client.desktop.name}" Style="{StaticResource Secondary}" Padding="14,5"
                                Command="{Binding OpenDesktopCommand}" ToolTip="{loc:T client.desktop.tip}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:T client.tile.createShortcut}"
                                              Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.Tag.DesktopTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:T client.tile.addToStartMenu}"
                                              Command="{Binding PlacementTarget.Tag.AddToStartMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.Tag.DesktopTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DockPanel>

                    <Grid>
                        <!-- Empty state: host without apps -->
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                   Text="{loc:T client.main.noApps}"
                                   Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}" />

                        <!-- One click selects, double click or Enter opens (like the Windows desktop); F2 renames. -->
                        <ListBox x:Name="AppsList" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}" SelectionMode="Single"
                                 Background="Transparent" BorderThickness="0" Padding="18,4,18,12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnAppsKeyDown"
                                 AutomationProperties.Name="{loc:T client.main.appsList}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ItemTemplate">
                                        <Setter.Value>
                                            <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                                                <StackPanel>
                                                    <Grid Width="48" Height="48" Margin="0,6,0,8">
                                                        <Border CornerRadius="8" Background="{DynamicResource Accent}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ItemTemplate">
                                                <Setter.Value>
                                                    <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                                                        <DockPanel>
                                                            <Grid Width="28" Height="28" Margin="0,0,12,0">
                                                                <Border CornerRadius="5" Background="{DynamicResource Accent}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="128" />
                                    <Setter Property="Height" Value="120" />
                                    <Setter Property="Margin" Value="6" />
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnAppDoubleClick" />
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnAppRightButtonDown" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileSelected}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T client.tile.open}" FontWeight="SemiBold" InputGestureText="Enter"
                                                          Command="{Binding PlacementTarget.Tag.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{loc:T client.tile.rename}" InputGestureText="F2" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}"
                                                          Command="{Binding PlacementTarget.Tag.RenameAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{loc:T client.tile.resetName}" Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVis}}"
                                                          Command="{Binding PlacementTarget.Tag.ResetAppNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{loc:T client.tile.createShortcut}"
                                                          Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{loc:T client.tile.addToStartMenu}"
                                                          Command="{Binding PlacementTarget.Tag.AddToStartMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsListView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="Height" Value="Auto" />
                                            <Setter Property="Margin" Value="6,2" />
                                            <Setter Property="Padding" Value="10,6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <!-- Settings page: replaces the host's area until "Back" -->
                <Border Background="{DynamicResource Background}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,18" MaxWidth="560" HorizontalAlignment="Left">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="{loc:T client.settings.back}" Style="{StaticResource Secondary}" Padding="10,4"
                                        Command="{Binding ToggleSettingsCommand}" />
                                <TextBlock Text="{loc:T client.main.settings}" FontSize="24" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{loc:T client.settings.general}" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="{loc:T client.main.closeToTray}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" ToolTip="{loc:T client.main.closeToTrayTip}" Margin="0,0,0,6" />
                            <CheckBox Content="{loc:T client.main.startWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,10" />
                            <Button Content="{loc:T client.main.configureSigning}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Command="{Binding ConfigureSigningCommand}" />

                            <TextBlock Text="{loc:T client.settings.appearance}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{loc:T client.main.theme}" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="ThemeSystem" Content="{loc:T common.theme.system}" GroupName="Theme" Margin="0,0,16,0" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeLight" Content="{loc:T common.theme.light}" GroupName="Theme" Margin="0,0,16,0" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeDark" Content="{loc:T common.theme.dark}" GroupName="Theme" Checked="OnThemeChecked" />
                            </StackPanel>
                            <Button Content="{loc:T common.language.menu}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnLanguageClick" />

                            <TextBlock Text="{loc:T client.settings.updates}" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="{loc:T client.main.autoUpdate}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" ToolTip="{loc:T client.main.autoUpdateTip}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:T client.main.checkUpdates}" Style="{StaticResource Secondary}" Command="{Binding CheckForUpdatesCommand}" />
                                <TextBlock Text="{Binding ClientVersionText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Progress overlay: releasing the host / opening an app (blocks clicks meanwhile) -->
                <Grid Background="{DynamicResource Overlay}" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="4" />
                                <Path Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock Text="{Binding ProgressMessage}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
