<Window x:Class="WRApperture.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Client.ViewModels"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        xmlns:ui="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WRApperture" Width="1040" Height="660" MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>

        <!-- A small rounded tag ("VPN", "Offline"). -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Grid / list switch: two radio buttons drawn as a segmented pill. -->
        <Style x:Key="ViewToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" Padding="14,7"
                                CornerRadius="{Binding (ui:Corner.Radius), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ⋯ menu of a host card: acts on the selected host (the button selects its card first). -->
        <ContextMenu x:Key="HostMenu">
            <MenuItem Header="{loc:T client.host.rename}" Command="{Binding RenameHostCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="color" Header="{loc:T client.host.color}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:T client.main.saveCredentials}" Command="{Binding SaveCredentialsCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:T client.main.deleteCredentials}" Command="{Binding DeleteCredentialsCommand}" />
            <MenuItem Header="{loc:T client.main.askBeforeRelease}" IsCheckable="True"
                      IsChecked="{Binding AskBeforeReleasingSession, Mode=TwoWay}"
                      ToolTip="{loc:T client.main.askBeforeReleaseTip}" />
            <Separator />
            <MenuItem Header="{loc:T client.main.syncNow}" Command="{Binding RefreshCommand}" InputGestureText="F5">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:T client.main.updateHost}" Command="{Binding UpdateHostCommand}"
                      Visibility="{Binding IsHostOutdated, Converter={StaticResource BoolToVis}}"
                      ToolTip="{loc:T client.main.updateHostTip}" ToolTipService.ShowOnDisabled="True">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:T client.main.removeHost}" Command="{Binding RemoveHostCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="{DynamicResource Error}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Hosts: straight on the window's backdrop -->
        <DockPanel Background="{DynamicResource Sidebar}">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T client.main.hosts}" FontSize="20" FontWeight="SemiBold" Margin="20,16,16,12" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                <Button Style="{StaticResource Subtle}" Command="{Binding ToggleSettingsCommand}" ToolTip="{loc:T client.main.settings}"
                        AutomationProperties.Name="{loc:T client.main.settings}" Padding="10,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                </Button>
                <Button Style="{StaticResource Subtle}" Command="{Binding AddHostCommand}" ToolTip="{loc:T client.main.addHost}" Margin="4,0,0,0"
                        AutomationProperties.Name="{loc:T client.main.addHost}" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                        <TextBlock Text="{loc:T client.main.addHost}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox x:Name="HostsList" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" Background="Transparent" Padding="10,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:T client.main.hosts}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource Surface}" CornerRadius="10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HostOption}">
                        <Grid Margin="10,10,6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Color stripe (hidden when no color) -->
                            <Border Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{Binding ColorBrush}"
                                    Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Style="{StaticResource Subtle}" Padding="6,2" Margin="0,-4,0,0" Click="OnHostMenuClick"
                                        ToolTip="{loc:T client.main.moreOptions}" AutomationProperties.Name="{loc:T client.main.moreOptions}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="14" />
                                </Button>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Tag}" Background="{DynamicResource SuccessBackground}"
                                                Visibility="{Binding HasVpn, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VPN" FontSize="11" Foreground="{DynamicResource Success}" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Background="{DynamicResource ErrorBackground}" Margin="4,0,0,0"
                                                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:T client.host.offline}" FontSize="11" Foreground="{DynamicResource Error}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AppsText}" FontSize="12" Foreground="{DynamicResource Faint}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The selected host (or the settings page): a translucent layer over the backdrop -->
        <Border Grid.Column="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,0,0"
                CornerRadius="10,0,0,0">
            <DockPanel>
                <!-- Status bar -->
                <Border DockPanel.Dock="Bottom" Padding="24,8" CornerRadius="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ClientVersionText}" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <!-- A newer client that was not installed automatically (automatic updates off) -->
                        <Button DockPanel.Dock="Right" Content="{Binding ClientUpdateLabel}" Style="{StaticResource Secondary}" Padding="12,3" Margin="12,0,0,0"
                                Command="{Binding InstallClientUpdateCommand}" Visibility="{Binding IsClientUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- Empty state: no hosts -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding ShowNoHost, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="40" Foreground="{DynamicResource Faint}" Margin="0,0,0,14" />
                        <TextBlock Text="{loc:T client.main.noHostTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18" Foreground="{DynamicResource Muted}"
                                   Text="{loc:T client.main.noHostText}" />
                        <Button Content="{loc:T client.main.addHost}" Style="{StaticResource Primary}" HorizontalAlignment="Center" Command="{Binding AddHostCommand}" />
                    </StackPanel>

                    <!-- Host: header, search, desktop, view switch, apps -->
                    <DockPanel Visibility="{Binding ShowHostArea, Converter={StaticResource BoolToVis}}">
                        <Grid DockPanel.Dock="Top" Margin="28,20,28,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedHost.Label}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" Padding="12,4" CornerRadius="14"
                                    Background="{DynamicResource SuccessBackground}" ToolTip="{loc:T client.main.hostVpnTip}"
                                    Visibility="{Binding HasHostVpn, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE705;" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding HostVpnText}" Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DockPanel DockPanel.Dock="Top" Margin="28,4,28,10" LastChildFill="False">
                            <Grid DockPanel.Dock="Left" Width="280">
                                <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:T client.main.searchApps}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left"
                                           Margin="13,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="{loc:T client.main.searchPlaceholder}" Foreground="{DynamicResource Faint}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Tiles / list -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                <RadioButton GroupName="View" IsChecked="{Binding IsGridView}" Style="{StaticResource ViewToggle}" ui:Corner.Radius="16,0,0,16"
                                             ToolTip="{loc:T client.main.gridView}" AutomationProperties.Name="{loc:T client.main.gridView}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                                <RadioButton GroupName="View" IsChecked="{Binding IsListView}" Style="{StaticResource ViewToggle}" ui:Corner.Radius="0,16,16,0" Margin="1,0,0,0"
                                             ToolTip="{loc:T client.main.listView}" AutomationProperties.Name="{loc:T client.main.listView}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </StackPanel>

                            <Button x:Name="DesktopButton" DockPanel.Dock="Right" Style="{StaticResource Secondary}"
                                    Command="{Binding OpenDesktopCommand}" ToolTip="{loc:T client.desktop.tip}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T client.desktop.name}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T client.tile.createShortcut}"
                                                  Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.Tag.DesktopTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{loc:T client.tile.addToStartMenu}"
                                                  Command="{Binding PlacementTarget.Tag.AddToStartMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.Tag.DesktopTile, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DockPanel>

                        <Grid>
                            <!-- Empty state: host without apps -->
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                       Text="{loc:T client.main.noApps}"
                                       Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}" />

                            <!-- One click selects, double click or Enter opens (like the Windows desktop); F2 renames. -->
                            <ListBox x:Name="AppsList" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}" SelectionMode="Single"
                                     Background="Transparent" Padding="22,4,22,12"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnAppsKeyDown"
                                     AutomationProperties.Name="{loc:T client.main.appsList}">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ItemTemplate">
                                            <Setter.Value>
                                                <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                                                    <StackPanel>
                                                        <Grid Width="48" Height="48" Margin="0,8,0,10">
                                                            <Border CornerRadius="10" Background="{DynamicResource Accent}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel />
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ItemTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                                                            <DockPanel>
                                                                <Grid Width="28" Height="28" Margin="0,0,14,0">
                                                                    <Border CornerRadius="6" Background="{DynamicResource Accent}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Width" Value="128" />
                                        <Setter Property="Height" Value="124" />
                                        <Setter Property="Margin" Value="6" />
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnAppDoubleClick" />
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnAppRightButtonDown" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{DynamicResource Surface}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileSelected}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:T client.tile.open}" FontWeight="SemiBold" InputGestureText="Enter"
                                                              Command="{Binding PlacementTarget.Tag.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{loc:T client.tile.rename}" InputGestureText="F2" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.RenameAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{loc:T client.tile.resetName}" Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVis}}"
                                                              Command="{Binding PlacementTarget.Tag.ResetAppNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:T client.tile.createShortcut}"
                                                              Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{loc:T client.tile.addToStartMenu}"
                                                              Command="{Binding PlacementTarget.Tag.AddToStartMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsListView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                <Setter Property="Width" Value="Auto" />
                                                <Setter Property="Height" Value="Auto" />
                                                <Setter Property="Margin" Value="6,2" />
                                                <Setter Property="Padding" Value="12,8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </DockPanel>

                    <!-- Settings page: replaces the host's area until "Back" -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="28,20,28,20" MaxWidth="600" HorizontalAlignment="Left">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource Subtle}" Command="{Binding ToggleSettingsCommand}" Padding="10,8"
                                        ToolTip="{loc:T client.settings.back}" AutomationProperties.Name="{loc:T client.settings.back}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" />
                                </Button>
                                <TextBlock Text="{loc:T client.main.settings}" FontSize="28" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{loc:T client.settings.general}" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18,14">
                                <StackPanel>
                                    <CheckBox Content="{loc:T client.main.closeToTray}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" ToolTip="{loc:T client.main.closeToTrayTip}" Margin="0,0,0,10" />
                                    <CheckBox Content="{loc:T client.main.startWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,14" />
                                    <Button Content="{loc:T client.main.configureSigning}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Command="{Binding ConfigureSigningCommand}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T client.settings.appearance}" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:T client.main.theme}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton x:Name="ThemeSystem" Content="{loc:T common.theme.system}" GroupName="Theme" Margin="0,0,20,0" Checked="OnThemeChecked" />
                                        <RadioButton x:Name="ThemeLight" Content="{loc:T common.theme.light}" GroupName="Theme" Margin="0,0,20,0" Checked="OnThemeChecked" />
                                        <RadioButton x:Name="ThemeDark" Content="{loc:T common.theme.dark}" GroupName="Theme" Checked="OnThemeChecked" />
                                    </StackPanel>
                                    <Button Content="{loc:T common.language.menu}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnLanguageClick" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T client.settings.updates}" Style="{StaticResource SectionTitle}" />
                            <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18,14">
                                <StackPanel>
                                    <CheckBox Content="{loc:T client.main.autoUpdate}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" ToolTip="{loc:T client.main.autoUpdateTip}" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{loc:T client.main.checkUpdates}" Style="{StaticResource Secondary}" Command="{Binding CheckForUpdatesCommand}" />
                                        <TextBlock Text="{Binding ClientVersionText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Progress overlay: releasing the host / opening an app (blocks clicks meanwhile) -->
                    <Grid Background="{DynamicResource Overlay}" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource Popup}" CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Effect="{StaticResource PopupShadow}">
                            <StackPanel>
                                <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Ellipse Stroke="{DynamicResource Surface}" StrokeThickness="4" />
                                    <Path Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotation" />
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Grid>
                                <TextBlock Text="{Binding ProgressMessage}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
