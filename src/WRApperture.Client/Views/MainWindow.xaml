<Window x:Class="WRApperture.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Client.ViewModels"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WRApperture" Width="880" Height="600" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T client.main.hostLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Muted}" />
                    <ComboBox Width="240" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"
                              DisplayMemberPath="Label" IsEnabled="{Binding HasHost}" AutomationProperties.Name="{loc:T client.main.selectedHost}" />
                    <Button Content="{loc:T client.main.addHost}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding AddHostCommand}" />
                    <Button Content="{loc:T client.main.refresh}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="{loc:T client.main.refreshTip}" />
                    <Button x:Name="MoreButton" Content="⋯" Style="{StaticResource Secondary}" Margin="8,0,0,0" Padding="10,6" IsEnabled="{Binding HasHost}"
                            ToolTip="{loc:T client.main.moreOptions}" Click="OnMoreClick" AutomationProperties.Name="{loc:T client.main.moreOptions}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T client.main.saveCredentials}" Command="{Binding SaveCredentialsCommand}" />
                                <MenuItem Header="{loc:T client.main.deleteCredentials}" Command="{Binding DeleteCredentialsCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:T client.main.configureSigning}" Command="{Binding ConfigureSigningCommand}" />
                                <MenuItem Header="{loc:T client.main.askBeforeRelease}" IsCheckable="True"
                                          IsChecked="{Binding AskBeforeReleasingSession, Mode=TwoWay}"
                                          ToolTip="{loc:T client.main.askBeforeReleaseTip}" />
                                <Separator />
                                <MenuItem Header="{loc:T client.main.closeToTray}" IsCheckable="True"
                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                          ToolTip="{loc:T client.main.closeToTrayTip}" />
                                <MenuItem Header="{loc:T client.main.startWithWindows}" IsCheckable="True"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="{loc:T client.main.removeHost}" Command="{Binding RemoveHostCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2" Width="220">
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T client.main.searchApps}" />
                    <TextBlock Text="{loc:T client.main.searchPlaceholder}" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid>
            <!-- Empty state: no hosts -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasNoHost, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:T client.main.noHostTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" Foreground="{DynamicResource Muted}"
                           Text="{loc:T client.main.noHostText}" />
                <Button Content="{loc:T client.main.addHost}" Style="{StaticResource Primary}" HorizontalAlignment="Center" Command="{Binding AddHostCommand}" />
            </StackPanel>

            <!-- Empty state: host without apps -->
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Text="{loc:T client.main.noApps}"
                       Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}" />

            <!-- One click selects, double click or Enter opens (like the Windows desktop); F2 renames. -->
            <ListBox x:Name="AppsList" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp}" SelectionMode="Single"
                     Background="Transparent" BorderThickness="0" Padding="12" Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnAppsKeyDown"
                     AutomationProperties.Name="{loc:T client.main.appsList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="128" />
                        <Setter Property="Height" Value="120" />
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnAppDoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnAppRightButtonDown" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileSelected}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{loc:T client.tile.open}" FontWeight="SemiBold" InputGestureText="Enter"
                                              Command="{Binding PlacementTarget.Tag.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="{loc:T client.tile.rename}" InputGestureText="F2" Visibility="{Binding CanRename, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.RenameAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="{loc:T client.tile.resetName}" Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVis}}"
                                              Command="{Binding PlacementTarget.Tag.ResetAppNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="{loc:T client.tile.createShortcut}"
                                              Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="{loc:T client.tile.addToStartMenu}"
                                              Command="{Binding PlacementTarget.Tag.AddToStartMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                        <StackPanel>
                            <Grid Width="48" Height="48" Margin="0,6,0,8">
                                <Border CornerRadius="8" Background="{DynamicResource Accent}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Initial}" />
                                                <Setter Property="FontSize" Value="22" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <!-- Desktop tile: monitor glyph (Segoe MDL2 Assets "TVMonitor") -->
                                                    <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                                        <Setter Property="Text" Value="&#xE7F4;" />
                                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                        <Setter Property="FontSize" Value="26" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxHeight="36" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Progress overlay: releasing the host / opening an app (blocks clicks meanwhile) -->
            <Grid Background="{DynamicResource Overlay}" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="8" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="4" />
                            <Path Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding ProgressMessage}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
