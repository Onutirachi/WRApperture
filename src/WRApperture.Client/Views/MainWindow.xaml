<Window x:Class="WRApperture.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WRApperture" Width="880" Height="600" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                    <ComboBox Width="240" ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}"
                              DisplayMemberPath="Label" IsEnabled="{Binding HasHost}" AutomationProperties.Name="Host selecionado" />
                    <Button Content="Adicionar host" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding AddHostCommand}" />
                    <Button Content="⟳ Atualizar" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Buscar a lista de apps no host" />
                    <Button Content="⋯" Style="{StaticResource Secondary}" Margin="8,0,0,0" Padding="10,6" IsEnabled="{Binding HasHost}"
                            ToolTip="Mais opções" Click="OnMoreClick" AutomationProperties.Name="Mais opções">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Salvar credenciais do host…" Command="{Binding SaveCredentialsCommand}" />
                                <MenuItem Header="Remover credenciais salvas" Command="{Binding DeleteCredentialsCommand}" />
                                <Separator />
                                <MenuItem Header="Abrir apps sem alerta de segurança…" Command="{Binding ConfigureSigningCommand}" />
                                <MenuItem Header="Perguntar antes de encerrar a sessão do PC remoto" IsCheckable="True"
                                          IsChecked="{Binding AskBeforeReleasingSession, Mode=TwoWay}"
                                          ToolTip="Desmarcado (padrão): ao abrir um app com você logado no PC remoto, a sessão é encerrada sem perguntar e os programas abertos lá são fechados" />
                                <Separator />
                                <MenuItem Header="Remover host" Command="{Binding RemoveHostCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="2" Width="220">
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar apps" />
                    <TextBlock Text="Buscar apps…" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid>
            <!-- Empty state: no hosts -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasNoHost, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nenhum host configurado" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" Foreground="{StaticResource Muted}"
                           Text="No PC remoto, gere um token com 'wrahost agent token' e informe-o aqui junto com o endereço do PC." />
                <Button Content="Adicionar host" Style="{StaticResource Primary}" HorizontalAlignment="Center" Command="{Binding AddHostCommand}" />
            </StackPanel>

            <!-- Empty state: host without apps -->
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Text="Nenhum app publicado neste host. Publique com 'wrahost publish' no PC remoto e clique em Atualizar."
                       Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12" Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding AppsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                            <Button Width="128" Height="120" Margin="6" Cursor="Hand" ToolTip="{Binding DisplayName}"
                                    Foreground="{StaticResource Text}"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileHover}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Abrir" FontWeight="SemiBold"
                                                  Command="{Binding PlacementTarget.Tag.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Criar atalho na área de trabalho"
                                                  Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </Button.Tag>
                                <StackPanel>
                                    <Grid Width="48" Height="48" Margin="0,6,0,8">
                                        <Border CornerRadius="8" Background="{StaticResource Accent}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Progress overlay: releasing the host / opening an app (blocks clicks meanwhile) -->
            <Grid Background="#B3F4F5F7" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="8" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Stroke="{StaticResource Border}" StrokeThickness="4" />
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Text="{Binding ProgressMessage}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
