<UserControl x:Class="WRApperture.Client.Views.ProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WRApperture.Client.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <!-- "Opening Chrome… Connecting": a spinner and the step in progress (ProgressMessage / ProgressDetail). -->
    <Border Background="{DynamicResource Popup}" CornerRadius="12" Padding="28,22" MaxWidth="420" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <Grid Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Ellipse Stroke="{DynamicResource Surface}" StrokeThickness="4" />
                <Path Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock Text="{Binding ProgressMessage}" Foreground="{DynamicResource Text}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProgressDetail}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
