<Window x:Class="WRApperture.Host.Manager.Views.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <DockPanel Margin="0,0,0,14">
            <Image x:Name="IconPreview" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="AliasText" Foreground="{DynamicResource Muted}" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Nome exibido no cliente" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Nome" />

        <TextBlock Text="Programa" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Procurar…" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="PathBox" AutomationProperties.Name="Caminho do programa" />
        </DockPanel>

        <TextBlock Text="Argumentos de inicialização" Margin="0,12,0,4" />
        <RadioButton x:Name="NoArgs" Content="Nenhum" GroupName="Args" Margin="0,2" />
        <DockPanel Margin="0,2">
            <RadioButton x:Name="FixedArgs" Content="Sempre usar:" GroupName="Args" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ArgsBox" AutomationProperties.Name="Argumentos" IsEnabled="{Binding IsChecked, ElementName=FixedArgs}" />
        </DockPanel>
        <RadioButton x:Name="AnyArgs" Content="Aceitar argumentos enviados pelo cliente" GroupName="Args" Margin="0,2" />

        <CheckBox x:Name="ShowBox" Content="Mostrar nos clientes" Margin="0,12,0,0" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Publicar" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
