<Window x:Class="WRApperture.Host.Manager.Views.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <DockPanel Margin="0,0,0,14">
            <Image x:Name="IconPreview" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="AliasText" Foreground="{DynamicResource Muted}" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{loc:T manager.editor.name}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="{loc:T manager.editor.nameField}" />

        <TextBlock Text="{loc:T manager.editor.program}" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T manager.editor.browse}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="PathBox" AutomationProperties.Name="{loc:T manager.editor.pathField}" />
        </DockPanel>

        <TextBlock Text="{loc:T manager.editor.arguments}" Margin="0,12,0,4" />
        <RadioButton x:Name="NoArgs" Content="{loc:T manager.editor.noArguments}" GroupName="Args" Margin="0,2" />
        <DockPanel Margin="0,2">
            <RadioButton x:Name="FixedArgs" Content="{loc:T manager.editor.fixedArguments}" GroupName="Args" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ArgsBox" AutomationProperties.Name="{loc:T manager.editor.argumentsField}" IsEnabled="{Binding IsChecked, ElementName=FixedArgs}" />
        </DockPanel>
        <RadioButton x:Name="AnyArgs" Content="{loc:T manager.editor.anyArguments}" GroupName="Args" Margin="0,2" />

        <!-- Programs started with the app in remote sessions -->
        <TextBlock Text="{loc:T manager.editor.startWith}" FontWeight="SemiBold" Margin="0,16,0,2" />
        <TextBlock Text="{loc:T manager.editor.startWithHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
        <CheckBox x:Name="AutoStartBox" Content="{loc:T manager.editor.autoStartWith}" />
        <TextBlock x:Name="DetectedText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0" />
        <TextBlock Text="{loc:T manager.editor.alsoStart}" Margin="0,8,0,4" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button Content="{loc:T manager.editor.addStartWith}" Style="{StaticResource Secondary}" Click="OnAddStartWith" />
                <Button x:Name="RemoveStartWithButton" Content="{loc:T manager.editor.removeStartWith}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                        Click="OnRemoveStartWith" IsEnabled="False" />
            </StackPanel>
            <ListBox x:Name="StartWithList" Height="64" SelectionChanged="OnStartWithSelectionChanged"
                     AutomationProperties.Name="{loc:T manager.editor.alsoStart}" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T manager.editor.cancel}" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button x:Name="SaveButton" Content="{loc:T manager.editor.publish}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
