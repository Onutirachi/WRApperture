<Window x:Class="WRApperture.Host.Manager.Views.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Title="{loc:T manager.token.title}" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock Text="{loc:T manager.token.heading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:T manager.token.address}" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" />
            <TextBlock x:Name="AddressText" Grid.Column="1" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{loc:T manager.token.port}" Foreground="{DynamicResource Muted}" />
            <TextBlock x:Name="PortText" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <TextBlock Text="{loc:T manager.token.token}" Margin="0,4,0,4" />
        <DockPanel>
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="{loc:T manager.token.copy}" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnCopy" />
            <TextBox x:Name="TokenBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13" />
        </DockPanel>

        <TextBlock Text="{loc:T manager.token.fingerprint}" Margin="0,12,0,4" Foreground="{DynamicResource Muted}" />
        <TextBox x:Name="FingerprintBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" />

        <Border Background="{DynamicResource WarningBackground}" CornerRadius="8" Padding="10" Margin="0,14,0,0">
            <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                       Text="{loc:T manager.token.warning}" />
        </Border>

        <Button Content="{loc:T manager.token.close}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
