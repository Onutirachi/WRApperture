<Window x:Class="WRApperture.Host.Manager.Views.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo token de pareamento" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock Text="Informe estes dados no cliente WRApperture" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Endereço" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
            <TextBlock x:Name="AddressText" Grid.Column="1" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="Porta" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="PortText" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <TextBlock Text="Token (exibido apenas agora)" Margin="0,4,0,4" />
        <DockPanel>
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copiar" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnCopy" />
            <TextBox x:Name="TokenBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13" />
        </DockPanel>

        <TextBlock Text="Fingerprint (confira no cliente ao parear)" Margin="0,12,0,4" Foreground="{StaticResource Muted}" />
        <TextBox x:Name="FingerprintBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" />

        <Border Background="{StaticResource WarningBackground}" CornerRadius="4" Padding="10" Margin="0,14,0,0">
            <TextBlock Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                       Text="Clientes pareados com o token anterior precisam do novo token: no cliente, use Atualizar e informe-o quando for pedido." />
        </Border>

        <Button Content="Fechar" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
