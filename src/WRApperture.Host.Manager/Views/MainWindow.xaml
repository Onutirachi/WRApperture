<Window x:Class="WRApperture.Host.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Host.Manager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ManagerViewModel}"
        Title="WRApperture — PC host" Width="1040" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Read-only banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarningBackground}" Padding="16,8"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reabrir como administrador" Style="{StaticResource Secondary}" Command="{Binding ElevateCommand}" />
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                           Text="Modo somente leitura: abra como administrador para publicar, remover, preparar o PC ou gerar token." />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Published apps -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Apps publicados" Style="{StaticResource SectionTitle}" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="Adicionar programa ou atalho…" Style="{StaticResource Primary}" Margin="0,0,8,6" Command="{Binding AddFilesCommand}" />
                    <Button Content="Do Menu Iniciar…" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding PublishInstalledCommand}" />
                    <Button Content="Editar" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding EditCommand}" />
                    <Button Content="Remover" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding RemoveCommand}" />
                    <Button Content="⟳" Style="{StaticResource Secondary}" Margin="0,0,8,6" Padding="10,6" ToolTip="Atualizar" Command="{Binding RefreshCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="Dica: arraste atalhos ou programas .exe e solte nesta janela, ou copie-os no Explorer (Ctrl+C) e cole aqui (Ctrl+V)." />

                <Grid>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ListView ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" BorderThickness="0" Background="Transparent"
                                      MouseDoubleClick="OnAppDoubleClick" Margin="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Apps publicados">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                                        <DockPanel Margin="4,6">
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="360"
                                        Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Nenhum app publicado" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                           Text="Arraste para cá atalhos (da área de trabalho ou do Menu Iniciar) ou programas .exe." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- This PC -->
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Este PC" Style="{StaticResource SectionTitle}" />

                        <ItemsControl ItemsSource="{Binding Readiness}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReadinessItem}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="!" />
                                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                            <Setter Property="Text" Value="✓" />
                                                            <Setter Property="Foreground" Value="#15803D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Preparar este PC" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="20,4,0,0"
                                Command="{Binding PrepareCommand}" Visibility="{Binding HasPendingReadiness, Converter={StaticResource BoolToVis}}" />

                        <Separator Margin="0,14" />

                        <TextBlock Text="Conexão com os clientes" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Agente" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Column="1" Text="{Binding AgentState}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Endereço" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Addresses}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Text="Porta" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="3" Text="Pareado" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Paired}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Fingerprint" Foreground="{StaticResource Muted}" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Padding="0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Gerar novo token…" Style="{StaticResource Primary}" Command="{Binding NewTokenCommand}" />
                            <Button Content="Reiniciar agente" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RestartAgentCommand}"
                                    IsEnabled="{Binding AgentInstalled}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
