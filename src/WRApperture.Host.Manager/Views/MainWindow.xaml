<Window x:Class="WRApperture.Host.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WRApperture.Host.Manager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ManagerViewModel}"
        Title="{loc:T manager.main.title}" Width="1040" Height="800" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Read-only banner -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarningBackground}" Padding="16,8"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T manager.main.elevate}" Style="{StaticResource Secondary}" Command="{Binding ElevateCommand}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"
                           Text="{loc:T manager.main.readOnly}" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Published apps -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T manager.main.apps}" Style="{StaticResource SectionTitle}" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="{loc:T manager.main.addApp}" Style="{StaticResource Primary}" Margin="0,0,8,6" Command="{Binding AddFilesCommand}" />
                    <Button Content="{loc:T manager.main.fromStartMenu}" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding PublishInstalledCommand}" />
                    <Button Content="{loc:T manager.main.edit}" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding EditCommand}" />
                    <Button Content="{loc:T manager.main.remove}" Style="{StaticResource Secondary}" Margin="0,0,8,6" Command="{Binding RemoveCommand}" />
                    <Button x:Name="ThemeButton" Content="◐" Style="{StaticResource Secondary}" Margin="0,0,8,6" Padding="10,6" ToolTip="{loc:T manager.main.themeTip}"
                            Click="OnThemeClick" AutomationProperties.Name="{loc:T manager.main.theme}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="{loc:T manager.main.tip}" />

                <Grid>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ListView ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" BorderThickness="0" Background="Transparent"
                                      MouseDoubleClick="OnAppDoubleClick" Margin="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="{loc:T manager.main.apps}">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                                        <DockPanel Margin="4,6">
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="360"
                                        Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T manager.main.empty}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                           Text="{loc:T manager.main.emptyHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- This PC -->
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:T manager.main.thisPc}" Style="{StaticResource SectionTitle}" />

                        <ItemsControl ItemsSource="{Binding Readiness}" x:Name="ReadinessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReadinessItem}">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="!" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Ok">
                                                            <Setter Property="Text" Value="✓" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Advice">
                                                            <Setter Property="Text" Value="i" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="NotSupported">
                                                            <Setter Property="Text" Value="✕" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="{Binding ActionLabel}" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                                    Command="{Binding DataContext.FixItemCommand, ElementName=ReadinessList}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:T manager.main.prepare}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="20,4,0,0"
                                Command="{Binding PrepareCommand}" Visibility="{Binding HasPendingReadiness, Converter={StaticResource BoolToVis}}" />

                        <Separator Margin="0,14" />

                        <TextBlock Text="{loc:T manager.main.connection}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:T manager.main.agent}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Column="1" Text="{Binding AgentState}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="{loc:T manager.main.address}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Addresses}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Text="{loc:T manager.main.port}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="3" Text="{loc:T manager.main.paired}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Paired}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="4" Text="{loc:T manager.main.vpn}" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Vpns}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{loc:T manager.main.fingerprint}" Foreground="{DynamicResource Muted}" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Padding="0" />

                        <StackPanel Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <TextBlock Text="{loc:T manager.devices.title}" Foreground="{DynamicResource Muted}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Devices}" x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="{loc:T manager.devices.remove}" Style="{StaticResource Secondary}" Padding="8,2"
                                                    VerticalAlignment="Center" Command="{Binding DataContext.RemoveDeviceCommand, ElementName=DeviceList}" CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Text="{loc:T manager.devices.hint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:T manager.main.newToken}" Style="{StaticResource Secondary}" Command="{Binding NewTokenCommand}" />
                            <Button Content="{loc:T manager.main.restartAgent}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RestartAgentCommand}"
                                    IsEnabled="{Binding AgentInstalled}" />
                        </StackPanel>

                        <Separator Margin="0,14" />

                        <TextBlock Text="{loc:T manager.main.updates}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:T manager.main.version}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="{loc:T manager.main.latestVersion}" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersion}" TextWrapping="Wrap" />
                        </Grid>
                        <CheckBox Content="{loc:T manager.main.autoUpdate}" ToolTip="{loc:T manager.main.autoUpdateTip}" Margin="0,10,0,0"
                                  IsChecked="{Binding AutoUpdate, Mode=TwoWay}" IsEnabled="{Binding IsAdmin}" />
                        <Button Content="{loc:T manager.main.updateNow}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding UpdateNowCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
