<Window x:Class="WRApperture.Host.Manager.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Title="{loc:T manager.password.title}" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{loc:T manager.password.why}" />

        <TextBlock Text="{loc:T manager.password.password}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{loc:T manager.password.password}" />
        <TextBlock Text="{loc:T manager.password.confirm}" Margin="0,10,0,4" />
        <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="{loc:T manager.password.confirm}" />

        <Border Background="{DynamicResource WarningBackground}" CornerRadius="4" Padding="10" Margin="0,14,0,0">
            <TextBlock Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Text="{loc:T manager.password.effect}" />
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T manager.password.cancel}" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="{loc:T manager.password.save}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
