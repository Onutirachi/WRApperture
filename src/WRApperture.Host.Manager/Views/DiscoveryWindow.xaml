<Window x:Class="WRApperture.Host.Manager.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WRApperture.Ui;assembly=WRApperture.Ui"
        Title="{loc:T manager.discovery.title}" Width="620" Height="560" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource BaseWindow}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T manager.discovery.heading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="{loc:T manager.discovery.searchField}" />
            <TextBlock Text="{loc:T manager.discovery.search}" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,16,0" />
            <Button Content="{loc:T manager.discovery.cancel}" Style="{StaticResource Secondary}" IsCancel="True" />
            <Button Content="{loc:T manager.discovery.publish}" Style="{StaticResource Primary}" Margin="8,0,0,0" IsDefault="True" Click="OnPublish" />
        </StackPanel>

        <Border Background="{DynamicResource Surface}" CornerRadius="8">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="2,4" Checked="OnCheckedChanged" Unchecked="OnCheckedChanged">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding App.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Badge, Mode=OneWay}" Foreground="{DynamicResource Success}" />
                                </TextBlock>
                                <TextBlock Text="{Binding App.ExecutablePath}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
